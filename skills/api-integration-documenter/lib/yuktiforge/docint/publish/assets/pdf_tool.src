import Foundation
import PDFKit
import AppKit

// usage: pdf_tool info <pdf>            -> JSON {pages, texts:[...]}
//        pdf_tool render <pdf> <outdir> <dpi> -> writes page-NNN.png, prints JSON metrics per page
func fail(_ m: String) -> Never { FileHandle.standardError.write((m + "\n").data(using: .utf8)!); exit(2) }
let a = CommandLine.arguments
if a.count < 3 { fail("usage") }
guard let doc = PDFDocument(url: URL(fileURLWithPath: a[2])) else { fail("cannot open pdf") }
func json(_ o: Any) { let d = try! JSONSerialization.data(withJSONObject: o, options: [.sortedKeys]); print(String(data: d, encoding: .utf8)!) }
if a[1] == "info" {
    var texts: [String] = []
    for i in 0..<doc.pageCount { texts.append(doc.page(at: i)?.string ?? "") }
    json(["pages": doc.pageCount, "texts": texts])
} else if a[1] == "render" {
    if a.count < 5 { fail("usage") }
    let out = URL(fileURLWithPath: a[3]); let dpi = CGFloat(Double(a[4]) ?? 80)
    try? FileManager.default.createDirectory(at: out, withIntermediateDirectories: true)
    var metrics: [[String: Any]] = []
    for i in 0..<doc.pageCount {
        guard let page = doc.page(at: i) else { continue }
        let box = page.bounds(for: .mediaBox)
        let scale = dpi / 72.0
        let w = Int(box.width * scale), h = Int(box.height * scale)
        let cs = CGColorSpaceCreateDeviceRGB()
        guard let ctx = CGContext(data: nil, width: w, height: h, bitsPerComponent: 8, bytesPerRow: 0, space: cs, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue) else { fail("ctx") }
        ctx.setFillColor(CGColor(red: 1, green: 1, blue: 1, alpha: 1)); ctx.fill(CGRect(x: 0, y: 0, width: w, height: h))
        ctx.scaleBy(x: scale, y: scale)
        page.draw(with: .mediaBox, to: ctx)
        guard let img = ctx.makeImage() else { fail("img") }
        let rep = NSBitmapImageRep(cgImage: img)
        let png = rep.representation(using: .png, properties: [:])!
        let name = String(format: "page-%03d.png", i + 1)
        try! png.write(to: out.appendingPathComponent(name))
        // ink metrics from the raw pixels
        let data = ctx.data!.bindMemory(to: UInt8.self, capacity: w * h * 4); let bpr = ctx.bytesPerRow
        func ink(_ x0: Int, _ x1: Int, _ y0: Int, _ y1: Int) -> Double {
            var n = 0, total = 0
            for y in stride(from: y0, to: y1, by: 1) { for x in stride(from: x0, to: x1, by: 1) {
                let p = data + y * bpr + x * 4
                if Int(p[0]) + Int(p[1]) + Int(p[2]) < 720 { n += 1 }; total += 1 } }
            return total == 0 ? 0 : Double(n) / Double(total)
        }
        let mm = dpi / 25.4
        let side = max(1, Int(6 * mm))
        metrics.append(["page": i + 1, "width_px": w, "height_px": h, "file": name,
                        "ink": ink(0, w, 0, h), "left_margin_ink": ink(0, side, 0, h), "right_margin_ink": ink(w - side, w, 0, h),
                        "body_ink": ink(Int(15 * mm), w - Int(15 * mm), Int(18 * mm), h - Int(16 * mm))])
    }
    json(["pages": doc.pageCount, "metrics": metrics])
} else { fail("unknown command") }
